#!/usr/bin/env bash
set -e

[ -n "${1:-}" ] || { echo "Usage: $0 <commit-message>" >&2; exit 1; }
[ -d .git ] || { echo "Not a git repo (.git/ missing)" >&2; exit 1; }
printf '%s\n' "$1" > .git/COMMIT_EDITMSG
"${EDITOR:-nvim}" .git/COMMIT_EDITMSG
[ -s .git/COMMIT_EDITMSG ] || { echo "Empty message, aborting." >&2; exit 1; }
git commit -F .git/COMMIT_EDITMSG
